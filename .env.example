# Copy to .env for local development (`npm run dev`). .env is git-ignored.
# In production, set these in Netlify > Site configuration > Environment variables instead.

# Which CRM the contact form saves to: brevo (default) or hubspot.
CONTACT_PROVIDER=brevo

# Brevo (when CONTACT_PROVIDER=brevo)
BREVO_API_KEY=
BREVO_LIST_ID=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# HubSpot (when CONTACT_PROVIDER=hubspot)
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_LIST_ID=
HUBSPOT_OWNER_ID=
